# Server port (Render injects its own PORT automatically)
PORT=5050

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusmarket?retryWrites=true&w=majority

# Secret used to sign auth tokens
JWT_SECRET=replace_with_a_long_random_secret

# Directory used for uploaded images
UPLOAD_DIR=uploads
